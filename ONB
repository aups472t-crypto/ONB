-- ฟังก์ชันระเบิดพื้นที่ (ไม่ทำดาเมจกับตัวละครเราเอง)
local function detonateArea(position, radius, force, destroyBlocks)
	local exp = Instance.new("Explosion")
	exp.Position = position
	exp.BlastRadius = radius
	exp.BlastPressure = force
	exp.DestroyJointRadiusPercent = 0
	exp.Parent = workspace

	-- ป้องกันไม่ให้แรงระเบิด/ผลกระทบทำอันตรายตัวละครเรา
	local myChar = LocalPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	local prevHealth = myHum and myHum.Health

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if myChar then
		params.FilterDescendantsInstances = {myChar, aimRing}
	else
		params.FilterDescendantsInstances = {aimRing}
	end

	local parts = workspace:GetPartBoundsInRadius(position, radius, params)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and not part.Locked then
			if destroyBlocks and part.Size.Magnitude < 120 then
				part.Anchored = false
				part:BreakJoints()
			end
		end
	end

	if myHum and prevHealth and myHum.Health < prevHealth then
		myHum.Health = prevHealth
	end
end

-- ฟังก์ชันฝนดาวตก: ต้องตกถึงพื้นหรือชนตึกก่อนค่อยระเบิด
local function triggerMeteorShower()
	if isMeteorRunning then return end
	isMeteorRunning = true

	MeteorBanner.Visible = true
	task.delay(3.5, function()
		if MeteorBanner then
			MeteorBanner.Visible = false
		end
	end)

	local endTime = os.clock() + 10
	task.spawn(function()
		while os.clock() < endTime do
			for _ = 1, 3 do
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local spreadX = math.random(-105, 105)
					local spreadZ = math.random(-105, 105)
					local spawnPos = root.Position + Vector3.new(spreadX + math.random(-20, 20), 115, spreadZ + math.random(-20, 20))
					local fallDir = (Vector3.new(root.Position.X + spreadX, root.Position.Y - 30, root.Position.Z + spreadZ) - spawnPos).Unit

					local meteor = Instance.new("Part")
					meteor.Shape = Enum.PartType.Ball
					meteor.Size = Vector3.new(4.5, 4.5, 4.5)
					meteor.Material = Enum.Material.Neon
					meteor.Color = Color3.fromRGB(255, 90, 15)
					meteor.Position = spawnPos
					meteor.Anchored = true
					meteor.CanCollide = false
					meteor.Parent = workspace

					task.spawn(function()
						local speed = 125
						local maxLife = 3.5
						local elapsed = 0

						while meteor.Parent and elapsed < maxLife do
							local dt = RunService.RenderStepped:Wait()
							elapsed += dt

							local stepDist = speed * dt
							local rayParams = RaycastParams.new()
							rayParams.FilterType = Enum.RaycastFilterType.Exclude
							rayParams.FilterDescendantsInstances = {meteor, aimRing, LocalPlayer.Character}

							local hit = workspace:Raycast(meteor.Position, fallDir * (stepDist + 1.5), rayParams)
							if hit then
								meteor.Position = hit.Position
								detonateArea(hit.Position, 26, 900000, true)
								meteor:Destroy()
								break
							else
								meteor.Position += fallDir * stepDist
							end
						end

						if meteor.Parent then
							meteor:Destroy()
						end
					end)
				end
			end
			task.wait(0.16)
		end
		isMeteorRunning = false
	end)
end

-- ฟังก์ชันจุดเล็งและเสกซูเปอร์โนวา (Local Preview)
local function getAimTargetPosition()
	local viewportCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
	local ray = Camera:ViewportPointToRay(viewportCenter.X, viewportCenter.Y)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {aimRing, LocalPlayer.Character}

	local result = workspace:Raycast(ray.Origin, ray.Direction * 1200, rayParams)
	if result then
		return result.Position
	end
	return ray.Origin + ray.Direction * 300
end

local function triggerSupernova(targetPos)
	if isSupernovaRunning then return end
	isSupernovaRunning = true
	supernovaAimActive = false
	aimRing.Parent = nil

	NovaBanner.Visible = true
	task.delay(4.5, function()
		if NovaBanner then
			NovaBanner.Visible = false
		end
	end)

	-- คัดซีนกล้อง (Local)
	local originalCameraType = Camera.CameraType
	local originalCFrame = Camera.CFrame
	Camera.CameraType = Enum.CameraType.Scriptable

	local novaCore = Instance.new("Part")
	novaCore.Shape = Enum.PartType.Ball
	novaCore.Size = Vector3.new(6, 6, 6)
	novaCore.Material = Enum.Material.Neon
	novaCore.Color = Color3.fromRGB(140, 230, 255)
	novaCore.Position = targetPos + Vector3.new(0, 75, 0)
	novaCore.Anchored = true
	novaCore.CanCollide = false
	novaCore.Parent = workspace

	local shockwave = Instance.new("Part")
	shockwave.Shape = Enum.PartType.Ball
	shockwave.Size = Vector3.new(8, 8, 8)
	shockwave.Material = Enum.Material.ForceField
	shockwave.Color = Color3.fromRGB(90, 200, 255)
	shockwave.Position = targetPos
	shockwave.Anchored = true
	shockwave.CanCollide = false
	shockwave.Transparency = 0.35
	shockwave.Parent = workspace

	task.spawn(function()
		local elapsed = 0
		local duration = 2.6
		while elapsed < duration do
			local dt = RunService.RenderStepped:Wait()
			elapsed += dt

			local progress = math.clamp(elapsed / duration, 0, 1)
			novaCore.Position = (targetPos + Vector3.new(0, 75, 0)):Lerp(targetPos, progress)
			novaCore.Size = Vector3.new(6, 6, 6) + Vector3.new(28, 28, 28) * progress

			local waveScale = 8 + (150 * progress)
			shockwave.Size = Vector3.new(waveScale, waveScale, waveScale)
			shockwave.Transparency = math.clamp(0.35 + progress * 0.6, 0, 1)

			local camPos = targetPos + Vector3.new(math.cos(elapsed * 1.4) * 95, 58, math.sin(elapsed * 1.4) * 95)
			local shake = Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2)) * 0.4
			Camera.CFrame = CFrame.lookAt(camPos + shake, targetPos)

			if progress >= 0.65 then
				detonateArea(targetPos, 95, 2500000, true)
			end
		end

		detonateArea(targetPos, 110, 3000000, true)
		novaCore:Destroy()
		shockwave:Destroy()

		Camera.CameraType = originalCameraType
		Camera.CFrame = originalCFrame
		isSupernovaRunning = false
	end)
end

